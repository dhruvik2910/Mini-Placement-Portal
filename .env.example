# ==============================================================================
# Mini Placement Portal - Environment Configuration Template
# ==============================================================================

# Backend API Configuration (apps/api/.env)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_VERSION=v1

# PostgreSQL Database Connection URL (used by Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL="postgresql://postgres:password@localhost:5432/placement_portal?schema=public"

# Authentication & Security
# Generate a cryptographically secure random string with: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_chars"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origin (Next.js frontend URL)
CORS_ORIGIN="http://localhost:3000"

# Frontend Configuration (apps/web/.env.local)
# ------------------------------------------------------------------------------
# Backend API Base URL
NEXT_PUBLIC_API_URL="http://localhost:5000/api/v1"
